# Anthropic API キー（https://console.anthropic.com/）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Anthropic モデル ID
#   高精度版（推奨・既定）: claude-sonnet-4-6
#   低コスト・高速版: claude-haiku-4-5-20251001
#   最高精度版: claude-opus-4-7
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google OAuth credentials.json のパス
# Google Cloud Console で OAuth 2.0 Client ID (Desktop) を作成しダウンロードしたもの
GOOGLE_CREDENTIALS_PATH=./credentials.json

# OAuth トークン保存先（npm run auth で生成）
GOOGLE_TOKEN_PATH=./token.json
